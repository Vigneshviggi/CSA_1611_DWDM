print("\n4.2 Handling Missing Values")

numeric_columns = df.select_dtypes(
    include=np.number
).columns

for column in numeric_columns:

    if df[column].isnull().sum() > 0:

        median_value = df[column].median()

        df[column] = df[column].fillna(
            median_value
        )


print("Missing numerical values replaced using median.")


# ------------------------------------------------
# 4.3 STANDARDIZE CATEGORIES
# ------------------------------------------------

print("\n4.3 Standardizing Categories")


def standardize_building_type(value):

    value = str(value).strip().lower()

    if value == "residential":
        return "Residential"

    elif value == "commercial":
        return "Commercial"

    elif value in ["public", "public building"]:
        return "Public"

    elif value == "industrial":
        return "Industrial"

    return "Unknown"


df["building_type"] = (
    df["building_type"]
    .apply(standardize_building_type)
)


print(
    df["building_type"]
    .value_counts()
)


# ------------------------------------------------
# 4.4 REMOVE DUPLICATES
# ------------------------------------------------

print("\n4.4 Removing Duplicate Records")

before_duplicates = len(df)

df = df.drop_duplicates()

after_duplicates = len(df)

print(
    "Duplicates removed:",
    before_duplicates - after_duplicates
)


# ------------------------------------------------
# 4.5 OUTLIER INSPECTION
# ------------------------------------------------

print("\n4.5 Outlier Inspection")

Q1 = df["monthly_kwh"].quantile(0.25)

Q3 = df["monthly_kwh"].quantile(0.75)

IQR = Q3 - Q1

lower_limit = Q1 - 1.5 * IQR

upper_limit = Q3 + 1.5 * IQR

outliers = df[
    (df["monthly_kwh"] < lower_limit)
    |
    (df["monthly_kwh"] > upper_limit)
]

print(
    "Potential energy outliers:",
    len(outliers)
)

# Domain-aware clipping
df["monthly_kwh"] = df[
    "monthly_kwh"
].clip(
    lower=lower_limit,
    upper=upper_limit
)


# ------------------------------------------------
# 4.6 RE-CALCULATE DERIVED VARIABLES
# ------------------------------------------------

df["cost_inr"] = (
    df["monthly_kwh"] * 8.25
)

df["co2_emissions_kg"] = (
