# ------------------------------------------------
# 6.4 FUNCTION FOR METRICS
# ------------------------------------------------

def calculate_metrics(
    actual,
    predicted
):

    return {

        "Accuracy":
            accuracy_score(
                actual,
                predicted
            ),

        "Precision":
            precision_score(
                actual,
                predicted,
                zero_division=0
            ),

        "Recall":
            recall_score(
                actual,
                predicted,
                zero_division=0
            ),

        "F1":
            f1_score(
                actual,
                predicted,
                zero_division=0
            )
    }


