print("=" * 70)


# ------------------------------------------------
# 10.1 CREATE TRANSACTION DATA
# ------------------------------------------------

transactions = pd.DataFrame({

    "EV Charging":
        df["ev_flag"].astype(bool),

    "High Peak":
        (
            df["peak_kw"]
            >= df["peak_kw"].quantile(
                0.70
            )
        ),

    "Cooling":
        (
            df["temperature"]
            >= df["temperature"].median()
        ),

    "High Occupancy":
        (
            df["occupancy"]
            >= df["occupancy"].median()
        ),

    "High Energy":
        (
            df["high_energy"] == 1
        ),

    "Low Efficiency":
        (
            df["efficiency_score"]
            <= df["efficiency_score"].median()
        ),

    "Solar":
        (
            df["solar_flag"] == 1
        ),

    "Efficiency":
        (
            df["efficiency_score"]
            >= df["efficiency_score"].median()
        ),

    "Lower Grid Use":
        (
            df["monthly_kwh"]
            <= df["monthly_kwh"].median()
        )
})


print(
    "\nTransaction dataset:"
)

print(
    transactions.head()
)


# ------------------------------------------------
# 10.2 APRIORI
# ------------------------------------------------

frequent_itemsets = apriori(
    transactions,
    min_support=0.20,
    use_colnames=True
)


print(
    "\nFrequent Itemsets:"
)

print(
    frequent_itemsets
    .sort_values(
        "support",
        ascending=False
    )
    .head(20)
)


# ------------------------------------------------
# 10.3 ASSOCIATION RULES
# ------------------------------------------------

if len(frequent_itemsets) > 0:

    rules = association_rules(
        frequent_itemsets,
        metric="confidence",
        min_threshold=0.60
    )

else:

    rules = pd.DataFrame()


if len(rules) > 0:

    rules = rules.sort_values(
        "lift",
        ascending=False
    )

    print(
        "\nGenerated Association Rules:"
    )

    print(
        rules[
            [
                "antecedents",
                "consequents",
                "support",
                "confidence",
                "lift"
            ]
        ].head(20)
    )


