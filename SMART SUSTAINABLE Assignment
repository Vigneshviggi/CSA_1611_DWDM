print("\n[1] Generating synthetic smart-city energy dataset...")

N = 1500

zones = [
    "North",
    "South",
    "Central",
    "East",
    "West",
    "South-West"
]

building_types = [
    "Residential",
    "Commercial",
    "Public",
    "Industrial"
]

zone = np.random.choice(
    zones,
    size=N,
    p=[0.17, 0.17, 0.18, 0.16, 0.16, 0.16]
)

building_type = np.random.choice(
    building_types,
    size=N,
    p=[0.40, 0.30, 0.15, 0.15]
)

# Building characteristics
floor_area = np.random.uniform(500, 10000, N)

occupancy = np.random.uniform(0.20, 1.00, N)

temperature = np.random.normal(
    loc=29.5,
    scale=2.0,
    size=N
)

humidity = np.random.uniform(45, 85, N)

rainfall = np.random.exponential(
    scale=40,
    size=N
)

# Efficiency score
efficiency_score = np.random.uniform(
    35,
    95,
    N
)

# Solar adoption
solar_flag = np.random.choice(
    [0, 1],
    size=N,
    p=[0.60, 0.40]
)

# EV infrastructure
ev_flag = np.random.choice(
    [0, 1],
    size=N,
    p=[0.70, 0.30]
)

# Base energy according to building type
base_energy = np.select(
    [
        building_type == "Residential",
        building_type == "Commercial",
        building_type == "Public",
        building_type == "Industrial"
    ],
    [
        2200,
        4200,
        5000,
        6200
    ]
)

# Energy consumption formula
monthly_kwh = (
    base_energy
    + floor_area * 0.25
    + occupancy * 1200
    + temperature * 60
    - efficiency_score * 15
    + np.random.normal(0, 500, N)
)

monthly_kwh = np.maximum(
    monthly_kwh,
    500
)

# Peak demand
peak_kw = (
    monthly_kwh / 120
    + occupancy * 15
    + ev_flag * 8
    + np.random.normal(0, 5, N)
)

peak_kw = np.maximum(
    peak_kw,
    5
)

# Solar generation
solar_kwh = (
    solar_flag
    * np.random.uniform(300, 1800, N)
)

# EV energy
ev_kwh = (
    ev_flag
    * np.random.uniform(100, 900, N)
)

# Cost
cost_inr = monthly_kwh * 8.25

# CO2 emissions
co2_emissions = monthly_kwh * 0.68

# High energy target
high_energy_threshold = np.percentile(
    monthly_kwh,
    70
)

high_energy = (
    monthly_kwh >= high_energy_threshold
).astype(int)


